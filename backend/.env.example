# APPLICATION
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# DATABASE
MONGO_URI=mongodb://localhost:27017/sep490

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# EMAIL (Nodemailer - Dùng App Password của Gmail nếu có, nếu để trống thì hệ thống sẽ in OTP ra console để test)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password_here

# GOOGLE AUTH
GOOGLE_CLIENT_ID=your_google_client_id_here

# AI SERVICE (GEMINI & GROQ)
# Bạn có thể điền 1 key hoặc nhiều key cách nhau bằng dấu phẩy (GEMINI_API_KEYS) để tự động xoay tua không giới hạn:
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEYS=key_1,key_2,key_3
# Dự phòng cấp 2 với Groq AI (Llama 3 / Mixtral miễn phí siêu tốc):
GROQ_API_KEY=your_groq_api_key_here