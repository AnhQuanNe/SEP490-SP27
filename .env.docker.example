# Copy file này thành .env ở thư mục gốc nếu muốn tùy chỉnh port hoặc Google Sign-In cho Docker Compose
FRONTEND_PORT=80
BACKEND_PORT=5000
MONGO_PORT=27017

# Mặc định dùng Nginx reverse proxy cùng origin (/api).
# Chỉ đổi nếu deploy Frontend và Backend ở hai domain khác nhau.
VITE_API_URL=/api
VITE_SERVER_URL=
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# Lưu ý: các biến của backend (MONGO_URI, JWT_SECRET, EMAIL_USER, EMAIL_PASS,
# GOOGLE_CLIENT_ID, GEMINI_API_KEY, CLIENT_URL) được nạp từ backend/.env

